#!/usr/bin/env bash
# gateway —— 境内中转节点的管理命令。
#
# 与旧版(纯 nginx stream 转发)的根本区别: nginx 不再和 tun-server 说话。它只
# 终止 leaf 的 TLS_A, 然后经 loopback + proxy_protocol 把连接连同真实客户端 IP
# 交给 gateway(go); 跨境的 TLS_B 由 gateway(go) 自己发起, 因为只有会话的发起方
# 才能往会话内部写东西, 而真实 IP 的前导必须写在里面。
#
# 因此这里没有 mappings、没有出境 SNI、没有 ALPN 探测 —— 那些都由 heihaweb 下发
# 给 gateway(go)。本脚本只管这台机器自己的事: 端口、证书目录、进程与容器。
set -euo pipefail

CONF_DIR="/etc/gateway"
ENV_FILE="${CONF_DIR}/gateway.env"
NGINX_CONF="${CONF_DIR}/nginx.conf"
CONTAINER="gateway-nginx"
NGINX_IMAGE="${GATEWAY_NGINX_IMAGE:-nginx:1.27}"
SERVICE="gateway"

err() { echo "ERROR: $*" >&2; exit 1; }

# ---- 配置(全部是本机事实, 不走控制面) ----------------------------------------

gw_defaults() {
  LISTEN_PORT=443
  LOOPBACK_PORT=8443
  SSL_DIR="/etc/gateway/ssl"
  CERT_NAME="server"
}

gw_load_env() {
  gw_defaults
  # 用显式 if 而不是 `[ -f x ] && . x`: 后者在文件不存在时以非零收尾, 而脚本
  # 开头是 set -e —— 首次运行(还没有 env 文件)会直接把命令打死。
  if [ -f "$ENV_FILE" ]; then
    # shellcheck disable=SC1090
    . "$ENV_FILE"
  fi
}

gw_save_env() {
  mkdir -p "$CONF_DIR"
  cat > "$ENV_FILE" <<EOF
# 由 gateway 命令生成。这些是本机的物理属性, 不由 heihaweb 下发。
LISTEN_PORT=${LISTEN_PORT}
LOOPBACK_PORT=${LOOPBACK_PORT}
SSL_DIR=${SSL_DIR}
CERT_NAME=${CERT_NAME}
EOF
  echo "已保存到 ${ENV_FILE}"
}

gw_set() {
  gw_load_env
  while [ $# -gt 0 ]; do
    case "$1" in
      --listen-port)   LISTEN_PORT="$2"; shift 2 ;;
      --loopback-port) LOOPBACK_PORT="$2"; shift 2 ;;
      --ssl-dir)       SSL_DIR="$2"; shift 2 ;;
      --cert-name)     CERT_NAME="$2"; shift 2 ;;
      *) err "未知参数: $1" ;;
    esac
  done
  [ "$LISTEN_PORT" != "$LOOPBACK_PORT" ] || err "对外端口与 loopback 端口不能相同"
  gw_save_env
  gw_show
}

gw_show() {
  gw_load_env
  echo "对外端口(leaf 连这里)   : ${LISTEN_PORT}"
  echo "loopback 端口(交给 go)  : ${LOOPBACK_PORT}"
  echo "证书目录                : ${SSL_DIR}"
  echo "证书名(<name>.crt/.key) : ${CERT_NAME}"
  echo
  echo "绑定哪台 tun-server、出境 SNI、transport 由 heihaweb 下发, 不在这里配。"
  if [ -f "${SSL_DIR}/${CERT_NAME}.crt" ] && [ -f "${SSL_DIR}/${CERT_NAME}.key" ]; then
    echo "证书: 已就位"
  else
    echo "证书: **缺失** —— 需要 ${SSL_DIR}/${CERT_NAME}.crt 与 .key"
    echo "      必须是真实域名 + 受信任 CA 签发; 自签证书是明显可疑信号。"
  fi
}

# ---- nginx 容器 --------------------------------------------------------------

gw_nginx_start() {
  gw_load_env
  mkdir -p "$SSL_DIR"
  [ -f "$NGINX_CONF" ] || err "还没有 ${NGINX_CONF} —— 由 gateway(go) 拿到下发配置后生成, 先确认它已认领并在运行"
  docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
  docker run -d --name "$CONTAINER" --restart unless-stopped \
    --network host \
    -v "${NGINX_CONF}:/etc/nginx/nginx.conf:ro" \
    -v "${SSL_DIR}:/ssl:ro" \
    "$NGINX_IMAGE" >/dev/null
  echo "nginx 已启动 (${CONTAINER})"
}

gw_nginx_stop()    { docker rm -f "$CONTAINER" >/dev/null 2>&1 || true; echo "nginx 已停止"; }

# restart-nginx: 用户要求的那条命令。优先用 reload(不断连), 容器没跑就整体拉起。
gw_restart_nginx() {
  if docker ps --filter "name=^${CONTAINER}$" --filter status=running -q | grep -q .; then
    docker exec "$CONTAINER" nginx -t || err "配置校验失败, 未重载"
    docker exec "$CONTAINER" nginx -s reload
    echo "nginx 已重载(现有连接不受影响)"
  else
    gw_nginx_start
  fi
}

gw_nginx_logs()   { docker logs -f "$CONTAINER"; }

# ---- gateway(go) 进程 --------------------------------------------------------

gw_svc_start()   { systemctl start "$SERVICE"; echo "gateway 已启动"; }
gw_svc_stop()    { systemctl stop "$SERVICE"; echo "gateway 已停止"; }
gw_svc_restart() { systemctl restart "$SERVICE"; echo "gateway 已重启"; }
gw_svc_logs()    { journalctl -u "$SERVICE" -f; }

gw_status() {
  gw_show
  echo
  echo "--- gateway(go) ---"
  systemctl is-active "$SERVICE" 2>/dev/null || true
  echo "--- nginx 容器 ---"
  docker ps -a --filter "name=^${CONTAINER}$"
}

usage() {
  cat <<'EOF'
用法: gateway <命令>

配置(本机事实):
  set [--listen-port N] [--loopback-port N] [--ssl-dir DIR] [--cert-name NAME]
  show                    显示当前配置与证书状态

nginx:
  restart-nginx           重载 nginx(优先热重载, 未运行则启动)
  nginx-start | nginx-stop | nginx-logs

gateway(go):
  start | stop | restart | logs

其他:
  status                  配置 + 两个组件的运行状态

绑定的 tun-server、出境 SNI、transport 由 heihaweb 下发; 本命令不涉及。
EOF
}

main() {
  case "${1:-}" in
    set)            shift; gw_set "$@" ;;
    show)           gw_show ;;
    restart-nginx)  gw_restart_nginx ;;
    nginx-start)    gw_nginx_start ;;
    nginx-stop)     gw_nginx_stop ;;
    nginx-logs)     gw_nginx_logs ;;
    start)          gw_svc_start ;;
    stop)           gw_svc_stop ;;
    restart)        gw_svc_restart ;;
    logs)           gw_svc_logs ;;
    status)         gw_status ;;
    ""|-h|--help)   usage ;;
    *)              usage; exit 1 ;;
  esac
}

if [ "${GATEWAY_LIB:-0}" != "1" ]; then
  main "$@"
fi
